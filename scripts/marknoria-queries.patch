+.notes-heading { gap:16px; padding:16px 20px; border-bottom:1px solid var(--reader-border,#d5dee2); }
+.notes-heading h2 { margin:0; font-size:17px; line-height:1.5; }
+.notes-heading p { margin:3px 0 0; color:var(--notes-muted); font-size:12px; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
+.notes-heading>div { min-width:0; }
+.notes-close { flex-shrink:0; }
+.notes-filters { display:flex; gap:4px; padding:10px 16px; border-bottom:1px solid var(--reader-border,#d5dee2); }
+.notes-filters button { border:0; background:transparent; padding:6px 12px; }
+.notes-filters button[aria-pressed="true"] { background:var(--notes-brand-soft); color:var(--notes-brand); font-weight:600; }
+.notes-filters { flex-wrap:wrap; align-items:center; }
+.notes-filters .notes-clear { margin-left:auto; }
+.notes-confirm { height:auto; width:min(460px,calc(100vw - 24px)); }
+.notes-confirm-body { margin:0; padding:20px; line-height:1.7; overflow:auto; }
+.notes-confirm[open] { grid-template-rows:auto minmax(0,1fr) auto; }
+.notes-confirm .notes-editor-actions { flex-wrap:wrap; }
+.dialog-close { flex:none; width:32px; height:32px; padding:0; font-size:22px !important; line-height:1; }
+.notes-workspace { display:grid; grid-template-columns:minmax(190px,29%) minmax(0,1fr); min-height:0; overflow:hidden; }
+.notes-list { overflow:auto; min-width:0; padding:10px; border-right:1px solid var(--reader-border,#d5dee2); background:var(--notes-soft); }
+.notes-list .note-row { display:flex; flex-direction:column; gap:7px; width:100%; margin:0 0 8px; padding:12px; text-align:left; border-radius:9px; background:var(--reader-panel,#fff); }
+.note-row[aria-pressed="true"] { border-color:var(--notes-brand); box-shadow:0 0 0 1px var(--notes-brand); }
+.note-row strong { font-size:12px; }
+.note-row span { display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; overflow-wrap:anywhere; font-size:13px; line-height:1.55; }
+.note-row small { color:var(--notes-muted); font-size:11px; }
+.notes-detail { min-width:0; overflow:auto; padding:20px; }
+.notes-detail .note-card { padding:0; margin:0; border:0; border-radius:0; }
+.note-card-heading { display:flex; justify-content:space-between; gap:12px; align-items:center; }
+.note-kind { display:inline-block; padding:3px 8px; border-radius:6px; background:var(--notes-brand-soft); color:var(--notes-brand); font-size:12px; }
+.note-kind.favorite { background:#fff5dd; color:#a96800; }
+.note-card time,.note-location { color:var(--notes-muted); font-size:12px; }
+.notes-dialog h3 { margin:20px 0 8px; font-size:12px; color:var(--notes-muted); }
+.notes-dialog blockquote { margin:0; padding:12px 14px; border:1px solid var(--reader-border,#d5dee2); border-left:3px solid var(--notes-brand); border-radius:7px; background:var(--notes-soft); white-space:pre-wrap; overflow-wrap:anywhere; font-size:14px; line-height:1.7; }
+.note-comment { white-space:pre-wrap; overflow-wrap:anywhere; font-size:14px; line-height:1.7; }
+.notes-actions { gap:8px; }
+.notes-dialog .notes-primary { background:var(--notes-brand); color:white; border-color:var(--notes-brand); }
+.notes-dialog .notes-danger { margin-left:auto; color:#b83a45; }
+.notes-footer { display:flex; align-items:center; justify-content:space-between; gap:10px; padding:8px 16px; border-top:1px solid var(--reader-border,#d5dee2); color:var(--notes-muted); font-size:12px; }
+.notes-footer .notes-actions { margin:0; }
+.notes-empty { display:grid; align-content:center; min-height:200px; text-align:center; color:var(--notes-muted); padding:20px; }
+.notes-editor { grid-template-rows:auto minmax(0,1fr) auto; }
+.notes-editor-body { min-height:0; overflow:auto; padding:0 20px 16px; display:flex; flex-direction:column; }
+.notes-editor-body blockquote { max-height:190px; overflow:auto; flex-shrink:0; }
+.notes-editor-body label { margin-top:16px; font-size:12px; color:var(--notes-muted); }
+.notes-editor-body textarea { box-sizing:border-box; flex:1; min-height:120px; margin:8px 0 0; border:1px solid var(--reader-border,#d5dee2); border-radius:7px; resize:vertical; }
+.notes-editor-actions { display:flex; flex-wrap:wrap; justify-content:flex-end; align-items:center; gap:8px; padding:12px 20px; border-top:1px solid var(--reader-border,#d5dee2); }
+.notes-editor-actions [role="status"] { flex:1; color:#b83a45; font-size:12px; }
+html[data-theme="dark"] .notes-dialog { --notes-soft:#1e2730; --notes-muted:#a2b3bd; --notes-brand:#53c7b5; --notes-brand-soft:#173b38; }
+html[data-theme="dark"] .notes-dialog .notes-primary { color:#111a1f; }
+@media(max-width:620px) { .notes-workspace { grid-template-columns:1fr; grid-template-rows:minmax(100px,30%) minmax(0,1fr); } .notes-list { border-right:0; border-bottom:1px solid var(--reader-border,#d5dee2); display:flex; gap:8px; } .notes-list .note-row { min-width:180px; max-width:240px; margin:0; } .notes-detail { padding:14px; } .notes-dialog .notes-danger { margin-left:0; } .notes-heading { padding:12px 14px; } }
+
+.reader-shell .table-content > table :is(th,td) { width:auto; }
+.table-column-resize { position: absolute; top: 0; width: 8px; z-index: 2; cursor: col-resize; touch-action: none; }
+.table-column-resize:hover,.table-column-resize:focus-visible { background: var(--reader-brand-soft); outline: 1px solid var(--reader-brand); }
+.table-resizing,.table-resizing * { cursor: col-resize !important; user-select: none; }
+.table-content.has-horizontal-overflow { padding-bottom: 18px; }
+.table-scrollbar { position: absolute; z-index: 3; height: 18px; padding-block: 4px; border: 1px solid var(--reader-border); border-radius: 4px; background: var(--reader-soft); touch-action: none; }
+.table-scrollbar-thumb { height: 8px; border-radius: 5px; background: var(--reader-faint); }
+.table-scrollbar:hover .table-scrollbar-thumb,.table-scrollbar:focus-visible .table-scrollbar-thumb { background: var(--reader-muted); }
+.table-measurement { position: fixed; left: 0; top: 0; visibility: hidden; pointer-events: none; width: max-content; }
+.reader-shell .column-width-reset { width: 100%; margin-top: 8px; }
diff --git a/crates/marknoria/web/table-controls.mjs b/crates/marknoria/web/table-controls.mjs
new file mode 100644
index 0000000..f3bd517
--- /dev/null
+++ b/crates/marknoria/web/table-controls.mjs
@@ -0,0 +1,142 @@
+// Shared document/SQL table toolbar: paging, column selection and sizing reset.
+import { pagerIcon } from './icons.mjs'
+
+export function tableControls({ names, selected, label = 'Table', previousLabel = 'Previous page', nextLabel = 'Next page', pageName = 'Table page', bounds, onApply }) {
+  const lifetime = new AbortController()
+  const controls = document.createElement('div')
+  controls.className = 'table-controls'
+  const position = document.createElement('span')
+  position.className = 'table-position'
+  const caption = document.createElement('div')
+  caption.className = 'table-caption'
+  const title = document.createElement('span')
+  title.className = 'table-label'
+  title.textContent = label
+  caption.append(title, position)
+  const actions = document.createElement('div')
+  actions.className = 'table-actions'
+  const previous = document.createElement('button')
+  previous.append(pagerIcon('previous'))
+  previous.title = previousLabel
+  previous.setAttribute('aria-label', previousLabel)
+  const next = document.createElement('button')
+  next.append(pagerIcon('next'))
+  next.title = nextLabel
+  next.setAttribute('aria-label', nextLabel)
+  const pageLabel = document.createElement('label')
+  pageLabel.className = 'table-page-label'
+  const pageInput = document.createElement('input')
+  pageInput.type = 'number'
+  pageInput.min = '1'
+  pageInput.className = 'table-page-number'
+  pageInput.setAttribute('aria-label', pageName)
+  const pageCount = document.createElement('span')
+  pageLabel.append(pageInput, pageCount)
+  const picker = document.createElement('details')
+  picker.className = 'column-picker'
+  const summary = document.createElement('summary')
+  summary.append(document.createTextNode('Columns'))
+  const columnCount = document.createElement('span')
+  columnCount.className = 'column-count'
+  summary.append(columnCount)
+  const panel = document.createElement('div')
+  panel.className = 'column-panel'
+  const panelTitle = document.createElement('strong')
+  panelTitle.className = 'column-panel-title'
+  panelTitle.textContent = 'Visible columns'
+  const search = document.createElement('input')
+  search.type = 'search'
+  search.placeholder = 'Find column…'
+  search.setAttribute('aria-label', 'Find column')
+  const choices = document.createElement('div')
+  choices.className = 'column-choices'
+  const all = document.createElement('button')
+  all.textContent = 'Select all'
+  const none = document.createElement('button')
+  none.textContent = 'Clear'
+  const apply = document.createElement('button')
+  apply.textContent = 'Apply'
+  const hint = document.createElement('span')
+  hint.className = 'column-selection-hint'
+  const draft = new Set(selected)
+  const updateSelection = () => {
+    apply.disabled = draft.size === 0
+    hint.textContent = `${draft.size} of ${names.length} selected`
+  }
+  updateSelection()
+  const checkboxes = names.map((name, column) => {
+    const label = document.createElement('label')
+    const checkbox = document.createElement('input')
+    checkbox.type = 'checkbox'
+    checkbox.checked = draft.has(column)
+    checkbox.value = column
+    const number = document.createElement('span')
+    number.className = 'column-number'
+    number.textContent = column + 1
+    const text = document.createElement('span')
+    text.className = 'column-name'
+    text.textContent = name || '(unnamed)'
+    label.append(checkbox, number, text)
+    choices.append(label)
+    checkbox.addEventListener('change', () => {
+      if (checkbox.checked) draft.add(column)
+      else draft.delete(column)
+      updateSelection()
+    })
+    return { label, checkbox, name: name.toLocaleLowerCase() }
+  })
+  search.addEventListener('input', () => {
+    const query = search.value.toLocaleLowerCase()
+    for (const choice of checkboxes) choice.label.hidden = !choice.name.includes(query)
+  })
+  const select = selected => {
+    for (const { checkbox } of checkboxes) checkbox.checked = selected
+    draft.clear()
+    if (selected) names.forEach((_, column) => draft.add(column))
+    updateSelection()
+  }
+  all.addEventListener('click', () => select(true))
+  none.addEventListener('click', () => select(false))
+  const shortcuts = document.createElement('div')
+  shortcuts.className = 'column-shortcuts'
+  shortcuts.append(all, none)
+  const footer = document.createElement('div')
+  footer.className = 'column-panel-footer'
+  footer.append(hint, apply)
+  panel.append(panelTitle, search, shortcuts, choices, footer)
+  const resetWidths = document.createElement('button')
+  resetWidths.className = 'column-width-reset'
+  resetWidths.textContent = 'Reset column widths'
+  panel.append(resetWidths)
+  picker.append(summary, panel)
+  actions.append(previous, pageLabel, next, picker)
+  controls.append(caption, actions)
+  const placePicker = () => {
+    if (!picker.open) return
+    const anchor = summary.getBoundingClientRect(), area = bounds().getBoundingClientRect()
+    const below = area.bottom - anchor.bottom - 16, above = anchor.top - area.top - 16
+    const upward = below < 340 && above > below
+    picker.dataset.side = upward ? 'above' : 'below'
+    panel.style.maxHeight = `${Math.max(0,Math.min(430,upward ? above : below))}px`
+    panel.style.maxWidth = `${Math.max(0,Math.min(336,area.width-24))}px`
+  }
+  apply.addEventListener('click', () => { if (!draft.size) return; picker.open = false; onApply([...draft].sort((a,b)=>a-b)) })
+  summary.addEventListener('click',event=>{event.preventDefault();picker.open=!picker.open;placePicker()})
+  picker.addEventListener('toggle', () => {
+    if (!picker.open) return
+    const root=controls.closest('.reader-shell')
+    for (const open of root.querySelectorAll('.column-picker[open]')) if(open!==picker)open.open=false
+    placePicker()
+  })
+  document.addEventListener('pointerdown',event=>{if(picker.open&&!picker.contains(event.target))picker.open=false},{signal:lifetime.signal})
+  document.addEventListener('keydown',event=>{if(event.key==='Escape'&&picker.open){event.preventDefault();event.stopImmediatePropagation();picker.open=false;summary.focus()}},{capture:true,signal:lifetime.signal})
+  const viewport=bounds()
+  viewport?.addEventListener('scroll',placePicker,{passive:true,signal:lifetime.signal})
+  const observer=new ResizeObserver(placePicker)
+  if(viewport)observer.observe(viewport)
+  columnCount.textContent=`${selected.length}/${names.length}`
+  return { controls, position, caption, actions, previous, next, pageLabel, pageInput, pageCount, picker, columnCount, resetWidths,
+    refresh:placePicker,
+    dispose(){lifetime.abort();observer.disconnect();picker.open=false},
+  }
+}
diff --git a/crates/marknoria/web/table-layout.mjs b/crates/marknoria/web/table-layout.mjs
new file mode 100644
index 0000000..012aa79
--- /dev/null
+++ b/crates/marknoria/web/table-layout.mjs
@@ -0,0 +1,266 @@
+// Geometry and input only: Rust still supplies the bounded row/column projection.
+const MIN = 48, MAX = 8192
+const clamp = width => Math.min(MAX, Math.max(MIN, Math.round(width)))
+
+export function tableLayout(article, content, state, readWidths, saveWidths, changed, context = {}) {
+  // The virtualizer constructs articles before attaching them to #space.
+  const viewport = context.viewport || document.querySelector('#viewport')
+  const shell = context.shell || document.querySelector('.reader-shell')
+  const workspace = context.workspace || document.querySelector('#workspace')
+  const signal = new AbortController()
+  const track = document.createElement('div')
+  track.className = 'table-scrollbar'
+  track.hidden = true
+  track.tabIndex = 0
+  track.role = 'scrollbar'
+  track.setAttribute('aria-label', 'Table horizontal scroll')
+  track.setAttribute('aria-orientation', 'horizontal')
+  track.setAttribute('aria-valuemin', '0')
+  content.id = `table-content-${article.dataset.table}`
+  track.setAttribute('aria-controls', content.id)
+  const thumb = document.createElement('div')
+  thumb.className = 'table-scrollbar-thumb'
+  track.append(thumb)
+  // A transformed virtual article offsets CSS sticky positioning. Keep the
+  // control in the stable workspace and place it after virtualizer layout.
+  workspace.append(track)
+  let table, group = null, cols = [], selected = [], natural = [], handles = [], manual = readWidths()
+  let drag = null, thumbDrag = null, layoutKey = '', stopped = false
+  const options = { signal: signal.signal }
+  // WebKit does not expose a layout box for <col>; measure real header cells.
+  const widths = () => [...table.rows[0].cells].map(cell => cell.getBoundingClientRect().width)
+  const key = () => `${content.clientWidth}:${getComputedStyle(shell).getPropertyValue('--column-width')}:${shell.classList.contains('no-wrap')}`
+  const rows = () => [...(table?.tBodies[0]?.rows || [])]
+  const samples = () => Array.from({ length: Math.min(table.rows.length, 200) }, (_, row) => table.rows[row])
+  const anchor = y => rows().find(row => row.getBoundingClientRect().bottom > y) || null
+  function keepRow(row, update) {
+    const top = row?.getBoundingClientRect().top
+    update()
+    changed(article)
+    if (row?.isConnected) viewport.scrollTop += row.getBoundingClientRect().top - top
+  }
+  function position() {
+    if (!table || stopped || !article.isConnected || viewport.getAttribute('aria-hidden') === 'true') { track.hidden = true; return }
+    const contentBounds = content.getBoundingClientRect(), viewBounds = viewport.getBoundingClientRect(), parentBounds = workspace.getBoundingClientRect()
+    const top = Math.min(contentBounds.bottom - 1, viewBounds.bottom) - 18
+    const left = Math.max(contentBounds.left + 1, viewBounds.left)
+    const right = Math.min(contentBounds.right - 1, viewBounds.right)
+    track.hidden = content.scrollWidth - content.clientWidth < 1 || top < Math.max(contentBounds.top, viewBounds.top) || contentBounds.top >= viewBounds.bottom || right <= left
+    if (track.hidden) return
+    track.style.left = `${left - parentBounds.left}px`
+    track.style.top = `${top - parentBounds.top}px`
+    track.style.width = `${right - left}px`
+  }
+  function sync() {
+    if (!table || stopped) return
+    const maximum = Math.max(0, content.scrollWidth - content.clientWidth)
+    state.horizontal = content.scrollLeft
+    content.classList.toggle('has-horizontal-overflow', maximum >= 1)
+    position()
+    track.setAttribute('aria-valuemax', String(Math.round(maximum)))
+    track.setAttribute('aria-valuenow', String(Math.round(content.scrollLeft)))
+    if (track.hidden) return
+    const size = Math.min(track.clientWidth, Math.max(32, track.clientWidth * content.clientWidth / content.scrollWidth))
+    thumb.style.width = `${size}px`
+    thumb.style.transform = `translateX(${(track.clientWidth - size) * content.scrollLeft / maximum}px)`
+  }
+  function apply() {
+    if (!table || !content.clientWidth) return
+    const limit = Math.max(80, Number.parseFloat(getComputedStyle(shell).getPropertyValue('--column-width')) || 180)
+    const sizes = natural.map(width => Math.max(64, Math.min(limit, width)))
+    if (!manual.size) {
+      const flexible = natural.flatMap((width, i) => width > limit ? [i] : [])
+      if (context.fillWidth && !flexible.length) flexible.push(...natural.map((_, i) => i))
+      const spare = Math.max(0, content.clientWidth - sizes.reduce((a, b) => a + b, 0))
+      for (const i of flexible) sizes[i] += spare / flexible.length
+    }
+    for (let i = 0; i < cols.length; i++) {
+      const width = manual.get(selected[i]) ?? sizes[i]
+      cols[i].style.width = `${width}px`
+      sizes[i] = width
+    }
+    table.style.width = `${sizes.reduce((a, b) => a + b, 0)}px`
+    const height = table.offsetHeight
+    let edge = 0
+    for (let i = 0; i < handles.length; i++) {
+      edge += sizes[i]
+      handles[i].style.left = `${edge - (i + 1 === handles.length ? 8 : 4)}px`
+      handles[i].style.height = `${height}px`
+      handles[i].setAttribute('aria-valuenow', String(Math.round(sizes[i])))
+    }
+    layoutKey = key()
+    sync()
+  }
+  function freeze() {
+    widths().forEach((width, i) => manual.set(selected[i], clamp(width)))
+  }
+  function remember() {
+    // Keep hidden original columns too, but bound each remembered table.
+    while (manual.size > 256) {
+      const hidden = [...manual.keys()].find(id => !selected.includes(id))
+      manual.delete(hidden ?? manual.keys().next().value)
+    }
+    saveWidths(new Map(manual))
+  }
+  function resize(column, width, row) {
+    keepRow(row, () => {
+      freeze()
+      manual.set(selected[column], clamp(width))
+      apply()
+      remember()
+    })
+  }
+  function fit(column, row) {
+    // Measure at most one projected column. Clone formatting, not source HTML.
+    const measure = document.createElement('div')
+    measure.className = 'table-measurement'
+    const sample = document.createElement('table')
+    sample.style.cssText = 'width:max-content;table-layout:auto'
+    for (const source of samples()) {
+      const cell = source.cells[column]?.cloneNode(true)
+      if (!cell) continue
+      if (cell.textContent.length > 16384) cell.textContent = cell.textContent.slice(0, 16384)
+      cell.style.cssText = 'width:auto;min-width:0;max-width:none;white-space:pre;overflow:visible'
+      sample.insertRow().append(cell)
+    }
+    measure.append(sample)
+    article.append(measure)
+    try { resize(column, sample.getBoundingClientRect().width, row) }
+    finally { measure.remove() }
+  }
+  const columnAt = event => {
+    const handle = event.target.closest('.table-column-resize')
+    return handle && content.contains(handle) ? Number(handle.dataset.column) : null
+  }
+  content.addEventListener('pointerdown', event => {
+    const column = columnAt(event)
+    if (column == null || event.button !== 0 || !table) return
+    event.preventDefault()
+    drag = { column, x: event.clientX, horizontal: content.scrollLeft, width: widths()[column], row: anchor(event.clientY) }
+    content.setPointerCapture(event.pointerId)
+    article.classList.add('table-resizing')
+  }, options)
+  content.addEventListener('pointermove', event => {
+    if (!drag) return
+    const dx = event.clientX - drag.x
+    if (Math.abs(dx) >= 1) resize(drag.column, drag.width + dx + content.scrollLeft - drag.horizontal, drag.row)
+  }, options)
+  const endDrag = () => { drag = null; article.classList.remove('table-resizing') }
+  content.addEventListener('lostpointercapture', endDrag, options)
+  content.addEventListener('pointerup', event => {
+    if (content.hasPointerCapture(event.pointerId)) content.releasePointerCapture(event.pointerId)
+    endDrag()
+  }, options)
+  content.addEventListener('dblclick', event => {
+    const column = columnAt(event)
+    if (column == null || !table) return
+    event.preventDefault()
+    fit(column, anchor(event.clientY))
+  }, options)
+  content.addEventListener('keydown', event => {
+    const column = columnAt(event)
+    if (column == null || !table) return
+    if (['ArrowLeft', 'ArrowRight', 'Home'].includes(event.key)) {
+      event.preventDefault()
+      const row = anchor(viewport.getBoundingClientRect().top)
+      if (event.key === 'Home') fit(column, row)
+      else resize(column, widths()[column] + (event.key === 'ArrowLeft' ? -16 : 16), row)
+    }
+  }, options)
+  content.addEventListener('scroll', sync, { ...options, passive: true })
+  const wheel = event => {
+    if (!event.shiftKey && !(event.currentTarget === track && event.deltaX)) return
+    if (content.scrollWidth <= content.clientWidth) return
+    const unit = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? content.clientWidth : 1
+    content.scrollLeft += (event.deltaX || event.deltaY) * unit
+    event.preventDefault()
+  }
+  content.addEventListener('wheel', wheel, { ...options, passive: false })
+  track.addEventListener('wheel', wheel, { ...options, passive: false })
+  track.addEventListener('pointerdown', event => {
+    if (event.button !== 0) return
+    event.preventDefault()
+    track.focus({ preventScroll: true })
+    if (event.target === thumb) {
+      thumbDrag = { x: event.clientX, left: content.scrollLeft }
+      track.setPointerCapture(event.pointerId)
+    } else {
+      content.scrollLeft += content.clientWidth * (event.clientX < thumb.getBoundingClientRect().left ? -1 : 1)
+    }
+  }, options)
+  track.addEventListener('pointermove', event => {
+    if (!thumbDrag) return
+    const travel = track.clientWidth - thumb.offsetWidth
+    if (travel > 0) content.scrollLeft = thumbDrag.left + (event.clientX - thumbDrag.x) * (content.scrollWidth - content.clientWidth) / travel
+  }, options)
+  track.addEventListener('pointerup', event => {
+    thumbDrag = null
+    if (track.hasPointerCapture(event.pointerId)) track.releasePointerCapture(event.pointerId)
+  }, options)
+  track.addEventListener('lostpointercapture', () => { thumbDrag = null }, options)
+  track.addEventListener('keydown', event => {
+    const maximum = content.scrollWidth - content.clientWidth
+    const targets = { ArrowLeft: content.scrollLeft - 40, ArrowRight: content.scrollLeft + 40, PageUp: content.scrollLeft - content.clientWidth, PageDown: content.scrollLeft + content.clientWidth, Home: 0, End: maximum }
+    if (event.key in targets) { event.preventDefault(); content.scrollLeft = targets[event.key] }
+  }, options)
+  const observer = new ResizeObserver(() => {
+    if (stopped || !article.isConnected) return
+    if (layoutKey !== key() && !drag) apply()
+    sync()
+  })
