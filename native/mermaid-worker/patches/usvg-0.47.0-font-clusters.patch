+/// Substitute complete, resolved clusters with exactly matching UTF-8 source ranges.
+/// Fonts may form different ligatures, so glyph counts and array positions are
+/// not interchangeable. Keep valid base clusters and their visual (bidi) order.
+fn replace_missing_clusters(glyphs: &[Glyph], fallback_glyphs: &[Glyph]) -> Vec<Glyph> {
+    let replacements: HashMap<_, _> = GlyphClusters::new(fallback_glyphs)
+        .filter_map(|(range, index)| {
+            let cluster = &fallback_glyphs[range.clone()];
+            if cluster.iter().any(Glyph::is_missing) {
+                return None;
+            }
+            let len = cluster.iter().map(|g| g.cluster_len).max().unwrap_or(0);
+            Some(((index.value(), len), range))
+        })
+        .collect();
+    let mut merged = Vec::with_capacity(glyphs.len());
+    for (range, index) in GlyphClusters::new(glyphs) {
+        let cluster = &glyphs[range.clone()];
+        let len = cluster.iter().map(|g| g.cluster_len).max().unwrap_or(0);
+        if cluster.iter().any(Glyph::is_missing) {
+            if let Some(replacement) = replacements.get(&(index.value(), len)) {
+                merged.extend_from_slice(&fallback_glyphs[replacement.clone()]);
+                continue;
+            }
+        }
+        merged.extend_from_slice(cluster);
+    }
+    merged
 }
 
