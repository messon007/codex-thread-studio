+//! Retain computed fonts through the shared whitespace/line planner.
+use super::cascade::ResolvedFallbackTypography;
+use crate::text::html_wrap::{NormalizedHtmlText, PlannedHtmlLine, plan_html_lines_with_ranges};
+use crate::text::{TextMeasurer, TextStyle};
+use std::{collections::HashMap, ops::Range, sync::Arc};
+
+pub(super) fn same_style(a: &ResolvedFallbackTypography, b: &ResolvedFallbackTypography) -> bool {
+    a.font_size.to_bits() == b.font_size.to_bits()
+        && a.font_family == b.font_family
+        && a.font_weight == b.font_weight
+        && a.font_style == b.font_style
+        && a.fill == b.fill
+}
+
+pub(super) struct StyledPart {
+    pub(super) range: Range<usize>,
+    pub(super) style: usize,
+}
+
+pub(super) struct RichText {
+    source: NormalizedHtmlText,
+    runs: Vec<(Range<usize>, usize)>,
+    pub(super) styles: Vec<Arc<ResolvedFallbackTypography>>,
+    fonts: Vec<TextStyle>,
+}
+
+impl RichText {
+    pub(super) fn new(
+        source: NormalizedHtmlText,
+        owners: Vec<(Range<usize>, usize)>,
+        fragments: &[Option<Arc<ResolvedFallbackTypography>>],
+        base: &ResolvedFallbackTypography,
+    ) -> Self {
+        let mut styles = vec![Arc::new(base.clone())];
+        let mut indices = HashMap::new();
+        let runs = owners
+            .into_iter()
+            .map(|(range, owner)| {
+                let index = fragments
+                    .get(owner)
+                    .and_then(Option::as_ref)
+                    .map_or(0, |style| {
+                        *indices.entry(Arc::as_ptr(style)).or_insert_with(|| {
+                            styles.push(style.clone());
+                            styles.len() - 1
+                        })
+                    });
+                (range, index)
+            })
+            .collect();
+        let fonts = styles.iter().map(|style| style.text_style()).collect();
+        Self {
+            source,
+            runs,
+            styles,
+            fonts,
+        }
+    }
+
+    // Ranges are in normalized source bytes. Only a selected terminal SHY may
+    // differ in the rendered string; its replacement keeps that source owner.
+    pub(super) fn parts(
+        &self,
+        text: &str,
+        source: &Range<usize>,
+        selected_hyphen: bool,
+    ) -> Vec<StyledPart> {
+        debug_assert!(selected_hyphen || text.len() == source.len());
+        let mut parts: Vec<StyledPart> = Vec::new();
+        let mut cursor = source.start;
+        let mut index = self.runs.partition_point(|(r, _)| r.end <= cursor);
+        while cursor < source.end {
+            let (end, style) = match self.runs.get(index) {
+                Some((run, _)) if cursor < run.start => (run.start.min(source.end), 0),
+                Some((run, style)) => (run.end.min(source.end), *style),
+                None => (source.end, 0),
+            };
+            let start_in_text = (cursor - source.start).min(text.len());
+            let end_in_text = if selected_hyphen && end == source.end {
+                text.len()
+            } else {
+                (end - source.start).min(text.len())
+            };
+            if start_in_text < end_in_text {
+                debug_assert!(
+                    text.is_char_boundary(start_in_text) && text.is_char_boundary(end_in_text)
+                );
+                if let Some(previous) = parts.last_mut()
+                    && same_style(&self.styles[previous.style], &self.styles[style])
+                {
+                    previous.range.end = end_in_text;
+                } else {
+                    parts.push(StyledPart {
+                        range: start_in_text..end_in_text,
+                        style,
+                    });
+                }
+            }
+            cursor = end;
+            if self
+                .runs
+                .get(index)
+                .is_some_and(|(run, _)| cursor >= run.end)
+            {
+                index += 1;
+            }
+        }
+        parts
+    }
+
+    pub(super) fn plan<E>(
+        &self,
+        width: Option<f64>,
+        measurer: &dyn TextMeasurer,
+        checkpoint: &mut impl FnMut() -> Result<(), E>,
+    ) -> Result<Vec<PlannedHtmlLine>, E> {
+        let checkpoint = std::cell::RefCell::new(checkpoint);
+        plan_html_lines_with_ranges(
+            &self.source,
+            width,
+            None,
+            &mut |text, range, hyphen| {
+                let mut width = 0.0;
+                for part in self.parts(text, &range, hyphen) {
+                    (checkpoint.borrow_mut())()?;
+                    let part_width = measurer
+                        .measure_html_line_width_px(&text[part.range], &self.fonts[part.style]);
+                    if !part_width.is_finite() || part_width < 0.0 {
+                        return Ok(f64::NAN);
+                    }
+                    width += part_width;
+                }
+                Ok(width)
+            },
+            &mut || (checkpoint.borrow_mut())(),
+        )
+    }
+
+    pub(super) fn bbox<E>(
+        &self,
+        line: &PlannedHtmlLine,
+        measurer: &dyn TextMeasurer,
+        checkpoint: &mut impl FnMut() -> Result<(), E>,
+    ) -> Result<(f64, f64), E> {
+        let mut width = 0.0;
+        let mut height: f64 = 0.0;
+        for part in self.parts(&line.text, &line.source_range, line.selected_hyphen) {
+            checkpoint()?;
+            let text = &line.text[part.range];
+            let w = measurer.measure_svg_raw_text_bbox_width_px(text, &self.fonts[part.style]);
+            checkpoint()?;
+            let h = measurer.measure_svg_raw_text_bbox_height_px(text, &self.fonts[part.style]);
+            if !w.is_finite() || !h.is_finite() || w < 0.0 || h < 0.0 {
+                return Ok((f64::NAN, f64::NAN));
+            }
+            width += w;
+            height = height.max(h);
+        }
+        Ok((width, height))
+    }
+}
