{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noEmitOnError": true,
    "verbatimModuleSyntax": true,
    "types": [],
    "rootDir": "ui-src",
    "outDir": "ui"
  },
  "include": ["ui-src/**/*.mts"]
}
